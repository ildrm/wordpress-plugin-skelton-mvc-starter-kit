{
  "name": "starterkit/wordpress-mvc-plugin",
  "description": "A WordPress-native MVC plugin starter kit",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=8.2"},
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1",
    "php-stubs/wordpress-stubs": "^6.5"
  },
  "autoload": {"psr-4": {"StarterKit\\Mvc\\": "app/"}},
  "autoload-dev": {"psr-4": {"StarterKit\\Mvc\\Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --debug --memory-limit=1G",
    "phpcs": "phpcs",
    "quality": ["@test", "@analyse", "@phpcs"]
  },
  "config": {"sort-packages": true, "platform": {"php": "8.2.0"}, "allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}}
}
